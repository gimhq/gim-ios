        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你會退出所有聊天，其他成員會看到你已退出。"
          }
        }
      }
    },
    "You need your recovery kit and Account ID to come back. Messages kept on this device are removed." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You need your recovery kit and Account ID to come back. Messages kept on this device are removed."
