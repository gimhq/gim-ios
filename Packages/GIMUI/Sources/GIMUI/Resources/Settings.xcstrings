          }
        }
      }
    },
    "This can't be undone, and your recovery key stops working. Servers that can't be reached now remove your account later on their own." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This can't be undone, and your recovery key stops working. Servers that can't be reached now remove your account later on their own."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede deshacer y tu clave de recuperación dejará de funcionar. Los servidores a los que no se pueda conectar ahora eliminarán tu cuenta más tarde por su cuenta."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此操作无法撤销，你的恢复密钥也将失效。目前无法连接的服务器稍后会自行删除你的账号。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此操作無法復原，你的復原金鑰也將失效。目前無法連線的伺服器稍後會自行刪除你的帳號。"
          }
        }
      }
    },
