    "Backs up your privacy settings and receives the reports you send. Your backup is encrypted." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Backs up your privacy settings and receives the reports you send. Your backup is encrypted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda una copia de tus ajustes de privacidad y recibe los reportes que envías. Tu copia de seguridad está cifrada."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "备份你的隐私设置，并接收你发送的举报。你的备份经过加密。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "備份你的隱私權設定，並接收你傳送的檢舉。你的備份經過加密。"
          }
