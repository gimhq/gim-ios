    "The Keep server backs up your privacy settings and receives the reports you send. Your backup is encrypted." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Keep server backs up your privacy settings and receives the reports you send. Your backup is encrypted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor Keep guarda una copia de tus ajustes de privacidad y recibe los reportes que envías. Tu copia de seguridad está cifrada."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep 服务器会备份你的隐私设置，并接收你发送的举报。你的备份经过加密。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep 伺服器會備份你的隱私權設定，並接收你傳送的檢舉。你的備份經過加密。"
          }
        }
      }
    },
    "Theme" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Theme"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
