    "Everything on this device is removed, including your messages." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything on this device is removed, including your messages."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se borra todo lo que hay en este dispositivo, incluidos tus mensajes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此设备上的所有内容都会被移除，包括你的消息。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此裝置上的所有內容都會被移除，包括你的訊息。"
          }
        }
      }
    },
    "Friends can no longer find you by it. Your Account ID still works." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
