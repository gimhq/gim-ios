    "Account IDs start with u. Recovery keys have 39 characters; dashes and spaces are fine." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Account IDs start with u. Recovery keys have 39 characters; dashes and spaces are fine."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los ID de cuenta empiezan por u. Las claves de recuperación tienen 39 caracteres; puedes incluir guiones y espacios."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "账号 ID 以 u 开头。恢复密钥有 39 个字符，可以带横线和空格。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "帳號 ID 以 u 開頭。復原金鑰有 39 個字元，可以帶連字號和空格。"
          }
        }
      }
    },
    "Account restored" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Account restored"
          }
        },
