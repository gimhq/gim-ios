    "Friends can find you with it. It's optional. You can add one later. 3 to 32 characters: a–z, 0–9, _ and ." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Friends can find you with it. It's optional. You can add one later. 3 to 32 characters: a–z, 0–9, _ and ."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus amigos pueden encontrarte con él. Es opcional. Puedes añadirlo más tarde. De 3 a 32 caracteres: a–z, 0–9, _ y ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "朋友可以用它找到你。这是可选的，你可以以后再设置。3 到 32 个字符：a–z、0–9、_ 和 ."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "朋友可以用它找到你。這是選填的，你可以之後再設定。3 到 32 個字元：a–z、0–9、_ 和 ."
          }
        }
      }
    },
