    "Old chats don't come back. Ask friends to add you to groups again." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Old chats don't come back. Ask friends to add you to groups again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los chats anteriores no se recuperan. Pide a tus amigos que te vuelvan a añadir a los grupos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以前的聊天不会回来。请朋友把你重新加进群组。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以前的聊天不會回來。請朋友把你重新加進群組。"
          }
        }
      }
    },
    "Paste all of it. We find your Account ID and recovery key in it." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paste all of it. We find your Account ID and recovery key in it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pégalo todo. Encontraremos ahí tu ID de cuenta y tu clave de recuperación."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全部粘贴进来。我们会从中找到你的账号 ID 和恢复密钥。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全部貼上。我們會從中找到你的帳號 ID 和復原金鑰。"
          }
        }
      }
    },
