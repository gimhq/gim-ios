    },
    "Already using gim on another device? Link this one. Lost all your devices? Restore with your recovery kit." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Already using gim on another device? Link this one. Lost all your devices? Restore with your recovery kit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Ya usas gim en otro dispositivo? Vincula este. ¿Perdiste todos tus dispositivos? Restaura tu cuenta con tu kit de recuperación."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已经在其他设备上使用 gim？关联这台设备。所有设备都丢了？用恢复资料恢复账号。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已經在其他裝置上使用 gim？連結這台裝置。所有裝置都遺失了？用復原資料復原帳號。"
          }
        }
      }
    },
