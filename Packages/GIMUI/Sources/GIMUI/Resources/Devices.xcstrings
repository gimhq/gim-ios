      }
    },
    "It will be signed out and removed from all your chats. This can't be undone." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It will be signed out and removed from all your chats. This can't be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se cerrará su sesión y se quitará de todos tus chats. No se puede deshacer."
