    "GIM can't use the camera. Allow camera access in Settings or paste the link code below." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GIM can't use the camera. Allow camera access in Settings or paste the link code below."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GIM no puede usar la cámara. Permite el acceso a la cámara en Ajustes o pega el código de vinculación abajo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GIM 无法使用相机。请在设置中允许使用相机，或在下方粘贴关联代码。"
