    "Messages go through your main server first. Your other servers keep a copy and take over when it is down." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Messages go through your main server first. Your other servers keep a copy and take over when it is down."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los mensajes pasan primero por tu servidor principal. Tus otros servidores guardan una copia y lo sustituyen cuando no funciona."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "消息会先经过你的主服务器。其他服务器会保存一份副本，在主服务器出问题时接替它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "訊息會先經過你的主要伺服器。其他伺服器會保存一份副本，在主要伺服器出問題時接手。"
          }
        }
      }
    },
