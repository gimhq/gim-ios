    },
    "This server hosts %lld groups you own. Removing it doesn't move them: they keep running there, and you still reach them through your other servers." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This server hosts %lld groups you own. Removing it doesn't move them: they keep running there, and you still reach them through your other servers."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este servidor aloja %lld grupos tuyos. Quitarlo no los mueve: siguen funcionando ahí y puedes acceder a ellos desde tus otros servidores."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这台服务器上有 %lld 个你创建的群组。移除它不会迁走这些群组：它们会继续在那里运行，你仍可通过其他服务器访问。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這台伺服器上有 %lld 個你建立的群組。移除它不會搬走這些群組：它們會繼續在那裡運作，你仍可透過其他伺服器存取。"
          }
        }
      }
    },
    "This server hosts 1 group you own. Removing it doesn't move them: they keep running there, and you still reach them through your other servers." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This server hosts 1 group you own. Removing it doesn't move them: they keep running there, and you still reach them through your other servers."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este servidor aloja 1 grupo tuyo. Quitarlo no lo mueve: sigue funcionando ahí y puedes acceder a él desde tus otros servidores."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这台服务器上有 1 个你创建的群组。移除它不会迁走这个群组：它会继续在那里运行，你仍可通过其他服务器访问。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這台伺服器上有 1 個你建立的群組。移除它不會搬走這個群組：它會繼續在那裡運作，你仍可透過其他伺服器存取。"
          }
        }
      }
    },
