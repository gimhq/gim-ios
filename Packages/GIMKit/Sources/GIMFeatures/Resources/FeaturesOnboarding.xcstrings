    },
    "We couldn't find an Account ID or recovery key here. Paste the whole kit, or type them below." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We couldn't find an Account ID or recovery key here. Paste the whole kit, or type them below."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No encontramos ningún ID de cuenta ni clave de recuperación aquí. Pega el kit completo o escríbelos abajo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这里找不到账号 ID 或恢复密钥。请粘贴完整的恢复资料，或在下面手动输入。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
