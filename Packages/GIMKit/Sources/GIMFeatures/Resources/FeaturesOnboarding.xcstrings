    },
    "Keep this secret. Anyone who has it can get into your account. Lost all your devices? Open gim, tap Restore and paste this text." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep this secret. Anyone who has it can get into your account. Lost all your devices? Open gim, tap Restore and paste this text."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se lo enseñes a nadie. Quien lo tenga puede entrar en tu cuenta. ¿Perdiste todos tus dispositivos? Abre gim, toca Restaurar y pega este texto."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请保密。拿到它的人都能进入你的账号。所有设备都丢了？打开 gim，点按“恢复”，然后粘贴这段文字。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請保密。拿到它的人都能進入你的帳號。所有裝置都遺失了？打開 gim，點一下「復原」，然後貼上這段文字。"
          }
        }
      }
    },
    "Part of the kit is missing. Fill in the empty field below." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Part of the kit is missing. Fill in the empty field below."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falta una parte del kit. Completa el campo vacío de abajo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "恢复资料缺了一部分。请填写下面的空白栏。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "復原資料少了一部分。請填寫下方的空白欄位。"
          }
        }
      }
    },
