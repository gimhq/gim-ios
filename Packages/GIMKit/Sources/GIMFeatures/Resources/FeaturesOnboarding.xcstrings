    "Someone already has this username. Try another one." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Someone already has this username. Try another one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alguien ya tiene este nombre de usuario. Prueba con otro."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这个用户名已经有人用了。换一个试试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這個使用者名稱已經有人使用。換一個試試。"
          }
        }
      }
    },
    "That doesn't match. Look at your recovery key and try again." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That doesn't match. Look at your recovery key and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No coincide. Revisa tu clave de recuperación e inténtalo de nuevo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不匹配。请看看你的恢复密钥，然后再试一次。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不相符。請看看你的復原金鑰，然後再試一次。"
          }
        }
      }
    },
    "This recovery key doesn't fit this account. Check the key and the Account ID." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This recovery key doesn't fit this account. Check the key and the Account ID."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta clave de recuperación no es de esta cuenta. Revisa la clave y el ID de cuenta."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这个恢复密钥和这个账号对不上。请检查密钥和账号 ID。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這個復原金鑰和這個帳號對不上。請檢查金鑰和帳號 ID。"
          }
        }
      }
    },
    "This server has no account with this Account ID. Check the ID and the server." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This server has no account with this Account ID. Check the ID and the server."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este servidor no tiene ninguna cuenta con este ID de cuenta. Revisa el ID y el servidor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这个服务器上没有这个账号 ID 的账号。请检查 ID 和服务器。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這個伺服器上沒有這個帳號 ID 的帳號。請檢查 ID 和伺服器。"
          }
        }
      }
    },
    "Use only letters, digits, underscores and dots." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use only letters, digits, underscores and dots."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa solo letras, números, guiones bajos y puntos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只能使用字母、数字、下划线和点。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只能使用字母、數字、底線和句點。"
          }
        }
      }
    },
    "Usernames are 3 to 32 characters long." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usernames are 3 to 32 characters long."
          }
